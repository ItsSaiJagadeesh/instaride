# Settings for the server. The setup script (setup-server.sh) writes this file for you. Never share or commit it.

# Your domain, already pointed at this server's IP address (an "A record" at your registrar).
DOMAIN=api.example.in

# The Super Admin account, created on the very first start. Password: 12+ characters.
ADMIN_PHONE=
ADMIN_PASSWORD=

# Signs login tokens. The setup script generates a long random value.
SESSION_SECRET=

# Address search asks for a contact email (OpenStreetMap's usage policy).
GEOCODER_CONTACT=

# Sign-in codes by SMS. Twilio is built in.
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Demo numbers for Google's reviewers (numbers you own, holding no real data). Remove after approval.
# Example: OTP_FIXED=9876500001:123456
OTP_FIXED=

# The 4-digit code a rider tells the driver to start a trip.
#   phone_last4 (default): the last 4 digits of the rider's mobile number. Easy to remember.
#   random: a new random code for every ride. Harder to guess, because it changes each time.
RIDE_CODE_MODE=phone_last4

# Phone sign-in by Google Firebase (instead of texting the code from this server, which needs DLT registration in India).
# Set to your Firebase project id (for example instaride-9f5eb), or run: sudo bash deploy/set-firebase.sh
# Numbers listed in OTP_FIXED always keep their fixed code. Leave empty to keep using codes from this server.
FIREBASE_PROJECT_ID=
