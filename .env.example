# ─────────────────────────────────────────────────────────────
# InstaRide environment configuration
# Copy this file to `.env` in the project folder. The server and the app launchers read it automatically.
# Never commit your real `.env` file.
# ─────────────────────────────────────────────────────────────

# Port for the Express backend. Defaults to 5000.
PORT=5000

# Host the apps use to reach the backend (no protocol).
# Local testing on a phone on the same Wi-Fi: use your computer's Wi-Fi address, NOT localhost
#   (Windows: run `ipconfig` and read IPv4 Address). Example: EXPO_PUBLIC_DOMAIN=192.168.1.20:5000  (plain http, local networks only)
# Production: EXPO_PUBLIC_DOMAIN=api.yourdomain.in  (the server must be behind https)
EXPO_PUBLIC_DOMAIN=localhost:5000

# Redis (primary data store). Run it with append-only persistence on, for example:
#   docker run -d --name instaride-redis -p 127.0.0.1:6379:6379 -v instaride-redis:/data redis:7 redis-server --appendonly yes
REDIS_URL=redis://127.0.0.1:6379

# REQUIRED in production: a long random string (32+ characters) used to sign login tokens.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Super Admin account, created on the very first start only. The Super Admin signs in to the web console
# with this phone number and password. Riders and drivers have NO password: they sign in with a code.
# In production both are required: ADMIN_PHONE is a 10-digit mobile number, ADMIN_PASSWORD is 12+ characters.
# In development, if ADMIN_PASSWORD is empty, a random one is generated and printed once.
ADMIN_PHONE=
ADMIN_PASSWORD=

# Where uploaded driver documents are stored (private; only the Super Admin can view them).
# Back this folder up and keep it on an encrypted disk. Defaults to ./data/uploads
UPLOADS_DIR=

# Browser origins allowed to call the API (comma separated), e.g. your admin web URL.
# Phone apps do not need this.
ALLOWED_ORIGINS=

# Address search. The apps search for places through this server using OpenStreetMap's free service, which
# asks users to identify themselves: put a contact email here (it goes into the request's User-Agent).
# For real volume, run your own Nominatim or a paid places service and set GEOCODER_URL to it.
GEOCODER_CONTACT=
GEOCODER_URL=

# ---------------------------------------------------------------------------------------------
# Sign-in codes (one-time passwords) sent by SMS to riders and drivers
# ---------------------------------------------------------------------------------------------
# Development: leave SMS_PROVIDER empty. Codes are then printed in the server window and no SMS is sent.
# Production: SMS_PROVIDER=twilio and fill in the three TWILIO lines. Without them, nobody can receive a code.
# In India the message text must be registered with your SMS provider (DLT). This is the exact text sent:
#   "123456 is your InstaRide verification code. It is valid for 5 minutes. Do not share it with anyone."
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# (or, instead of TWILIO_FROM:) TWILIO_MESSAGING_SERVICE_SID=

# Demo numbers for Google's Play Store reviewers. Each listed number always gets the code after the colon
# and no SMS is sent. Use numbers that hold no real data. Example: 9876500001:123456,9876500002:123456
OTP_FIXED=

# Testing only: every number gets this code. The server REFUSES TO START if this is set in production.
# OTP_TEST_CODE=123456
